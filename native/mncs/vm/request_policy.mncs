mncs 0.18;

// The VM's runtime policy boundary delegates artifact compatibility, request
// validation, resource resolution, call-target selection, and terminal-outcome
// classification to this bounded native reducer. Host code marshals values
// and projects typed results.
module mncs.vm.request_policy.v1;

use mncs.std.text_scan.v1 as text_scan;

record PolicyState {
    status: u64,
    steps: u64,
    call_depth: u64,
    memory_cells: u64,
    effects: u64,
    iterations: u64,
    seen_steps: bool,
    seen_call_depth: bool,
    seen_memory_cells: bool,
    seen_effects: bool,
    seen_iterations: bool
}

record CallResolutionState {
    valid: bool,
    found: bool,
    index: u64
}

record CallResolutionDecision {
    status: u64,
    index: u64
}

record BoundDimensionDecision {
    status: u64,
    index: u64
}

record EnvelopeMergeState {
    status: u64,
    steps: u64,
    call_depth: u64,
    memory_cells: u64,
    effects: u64,
    iterations: u64,
    seen_steps: bool,
    seen_call_depth: bool,
    seen_memory_cells: bool,
    seen_effects: bool,
    seen_iterations: bool,
    seen_override_steps: bool,
    seen_override_call_depth: bool,
    seen_override_memory_cells: bool,
    seen_override_effects: bool,
    seen_override_iterations: bool
}

fn tighter(current: u64, requested: u64) -> (result: u64) {
    if current <= requested {
        return current;
    }
    return requested;
}

fn dimension_code(name: [byte; up_to 64], name_length: u64) -> (result: u64) {
    let steps_name: [byte; 5] = [115, 116, 101, 112, 115];
    let call_depth_name: [byte; 10] = [99, 97, 108, 108, 95, 100, 101, 112, 116, 104];
    let memory_cells_name: [byte; 12] = [109, 101, 109, 111, 114, 121, 95, 99, 101, 108, 108, 115];
    let effects_name: [byte; 7] = [101, 102, 102, 101, 99, 116, 115];
    let iterations_name: [byte; 10] = [105, 116, 101, 114, 97, 116, 105, 111, 110, 115];
    if text_scan.equals(name, name_length, steps_name, 5) {
        return 0;
    }
    if text_scan.equals(name, name_length, call_depth_name, 10) {
        return 1;
    }
    if text_scan.equals(name, name_length, memory_cells_name, 12) {
        return 2;
    }
    if text_scan.equals(name, name_length, effects_name, 7) {
        return 3;
    }
    if text_scan.equals(name, name_length, iterations_name, 10) {
        return 4;
    }
    return 5;
}

// Compatibility refusal order is kept by the Rust admission adapter: VM
// artifact schema, identity verification, VM contract, bound declarations,
// then selected-SSA schema. Status 0 accepts; status 1 refuses.
fn classify_artifact_schema(schema: [byte; up_to 64], schema_length: u64) -> (result: u64) {
    let expected: [byte; 18] = [109, 110, 99, 115, 46, 118, 109, 46, 97, 114, 116, 105, 102, 97, 99, 116, 47, 49];
    if text_scan.equals(schema, schema_length, expected, 18) {
        return 0;
    }
    return 1;
}

fn classify_vm_contract(contract: [byte; up_to 64], contract_length: u64) -> (result: u64) {
    let expected: [byte; 11] = [109, 110, 99, 115, 46, 118, 109, 47, 48, 46, 49];
    if text_scan.equals(contract, contract_length, expected, 11) {
        return 0;
    }
    return 1;
}

fn classify_ssa_schema(schema: [byte; up_to 64], schema_length: u64) -> (result: u64) {
    let schema_05: [byte; 3] = [48, 46, 53];
    let schema_06: [byte; 3] = [48, 46, 54];
    if text_scan.equals(schema, schema_length, schema_05, 3)
        || text_scan.equals(schema, schema_length, schema_06, 3) {
        return 0;
    }
    return 1;
}

// The host streams declarations in ordered, 16-item packets. This keeps
// admission total for large manifests without adding a new artifact cap.
// Status 0 accepts the packet, 1 identifies the first unsupported dimension,
// and 2 means the transport supplied inconsistent lengths.
fn bound_dimension_step(
    state: BoundDimensionDecision,
    dimension: [byte; up_to 64],
    dimension_length: u64,
    index: u64
) -> (result: BoundDimensionDecision) {
    if state.status != 0 {
        return state;
    }
    if dimension_code(dimension, dimension_length) == 5 {
        return BoundDimensionDecision { ..state, status: 1, index: index };
    }
    return state;
}

fn classify_bound_dimensions(
    dimensions: [[byte; up_to 64]; up_to 16],
    dimension_lengths: [u64; up_to 16],
    dimension_count: u64
) -> (result: BoundDimensionDecision) {
    let initial: BoundDimensionDecision = BoundDimensionDecision {
        status: 0,
        index: 0
    };
    if dimension_count > 16
        || dimension_count != dimensions.len
        || dimension_count != dimension_lengths.len {
        return BoundDimensionDecision { ..initial, status: 2 };
    }
    iterate i over dimensions carrying state: BoundDimensionDecision = initial {
        next state = bound_dimension_step(state, dimensions[i], dimension_lengths[i], i);
    }
    return state;
}

fn merge_dimension(
    current: PolicyState,
    name: [byte; up_to 64],
    name_length: u64,
    requested: u64
) -> (result: PolicyState) {
    if current.status != 0 {
        return current;
    }
    let code: u64 = dimension_code(name, name_length);
    if code == 0 {
        if current.seen_steps {
            return PolicyState { ..current, status: 3 };
        }
        return PolicyState {
            ..current,
            steps: tighter(current.steps, requested),
            seen_steps: true
        };
    }
    if code == 1 {
        if current.seen_call_depth {
            return PolicyState { ..current, status: 3 };
        }
        return PolicyState {
            ..current,
            call_depth: tighter(current.call_depth, requested),
            seen_call_depth: true
        };
    }
    if code == 2 {
        if current.seen_memory_cells {
            return PolicyState { ..current, status: 3 };
        }
        return PolicyState {
            ..current,
            memory_cells: tighter(current.memory_cells, requested),
            seen_memory_cells: true
        };
    }
    if code == 3 {
        if current.seen_effects {
            return PolicyState { ..current, status: 3 };
        }
        return PolicyState {
            ..current,
            effects: tighter(current.effects, requested),
            seen_effects: true
        };
    }
    if code == 4 {
        if current.seen_iterations {
            return PolicyState { ..current, status: 3 };
        }
        return PolicyState {
            ..current,
            iterations: tighter(current.iterations, requested),
            seen_iterations: true
        };
    }
    return PolicyState { ..current, status: 3 };
}

fn merge_declared_envelope_dimension(
    current: EnvelopeMergeState,
    name: [byte; up_to 64],
    name_length: u64,
    requested: u64
) -> (result: EnvelopeMergeState) {
    if current.status != 0 {
        return current;
    }
    let code: u64 = dimension_code(name, name_length);
    if code == 0 {
        if current.seen_steps {
            return EnvelopeMergeState { ..current, status: 3 };
        }
        return EnvelopeMergeState { ..current, steps: requested, seen_steps: true };
    }
    if code == 1 {
        if current.seen_call_depth {
            return EnvelopeMergeState { ..current, status: 3 };
        }
        return EnvelopeMergeState { ..current, call_depth: requested, seen_call_depth: true };
    }
    if code == 2 {
        if current.seen_memory_cells {
            return EnvelopeMergeState { ..current, status: 3 };
        }
        return EnvelopeMergeState { ..current, memory_cells: requested, seen_memory_cells: true };
    }
    if code == 3 {
        if current.seen_effects {
            return EnvelopeMergeState { ..current, status: 3 };
        }
        return EnvelopeMergeState { ..current, effects: requested, seen_effects: true };
    }
    if code == 4 {
        if current.seen_iterations {
            return EnvelopeMergeState { ..current, status: 3 };
        }
        return EnvelopeMergeState { ..current, iterations: requested, seen_iterations: true };
    }
    return EnvelopeMergeState { ..current, status: 1 };
}

fn merge_override_envelope_dimension(
    current: EnvelopeMergeState,
    name: [byte; up_to 64],
    name_length: u64,
    requested: u64
) -> (result: EnvelopeMergeState) {
    if current.status != 0 {
        return current;
    }
    let code: u64 = dimension_code(name, name_length);
    if code == 0 {
        if current.seen_override_steps {
            return EnvelopeMergeState { ..current, status: 3 };
        }
        return EnvelopeMergeState {
            ..current,
            steps: select(current.seen_steps, tighter(current.steps, requested), requested),
            seen_steps: true,
            seen_override_steps: true
        };
    }
    if code == 1 {
        if current.seen_override_call_depth {
            return EnvelopeMergeState { ..current, status: 3 };
        }
        return EnvelopeMergeState {
            ..current,
            call_depth: select(current.seen_call_depth, tighter(current.call_depth, requested), requested),
            seen_call_depth: true,
            seen_override_call_depth: true
        };
    }
    if code == 2 {
        if current.seen_override_memory_cells {
            return EnvelopeMergeState { ..current, status: 3 };
        }
        return EnvelopeMergeState {
            ..current,
            memory_cells: select(current.seen_memory_cells, tighter(current.memory_cells, requested), requested),
            seen_memory_cells: true,
            seen_override_memory_cells: true
        };
    }
    if code == 3 {
        if current.seen_override_effects {
            return EnvelopeMergeState { ..current, status: 3 };
        }
        return EnvelopeMergeState {
            ..current,
            effects: select(current.seen_effects, tighter(current.effects, requested), requested),
            seen_effects: true,
            seen_override_effects: true
        };
    }
    if code == 4 {
        if current.seen_override_iterations {
            return EnvelopeMergeState { ..current, status: 3 };
        }
        return EnvelopeMergeState {
            ..current,
            iterations: select(current.seen_iterations, tighter(current.iterations, requested), requested),
            seen_iterations: true,
            seen_override_iterations: true
        };
    }
    return EnvelopeMergeState { ..current, status: 1 };
}

// Artifact declarations and caller overrides form one runtime envelope.
// Each input group is independently unique; the same dimension may occur
// once in both groups, in which case the tighter limit wins. Status 0
// accepts, 1 reports an unsupported dimension, 2 an inconsistent packet,
// and 3 a duplicate within one input group.
fn merge_runtime_envelope(
    declared_count: u64,
    declared_dimensions: [[byte; up_to 64]; up_to 5],
    declared_lengths: [u64; up_to 5],
    declared_values: [u64; up_to 5],
    override_count: u64,
    override_dimensions: [[byte; up_to 64]; up_to 5],
    override_lengths: [u64; up_to 5],
    override_values: [u64; up_to 5]
) -> (result: EnvelopeMergeState) {
    let initial: EnvelopeMergeState = EnvelopeMergeState {
        status: 0,
        steps: 0,
        call_depth: 0,
        memory_cells: 0,
        effects: 0,
        iterations: 0,
        seen_steps: false,
        seen_call_depth: false,
        seen_memory_cells: false,
        seen_effects: false,
        seen_iterations: false,
        seen_override_steps: false,
        seen_override_call_depth: false,
        seen_override_memory_cells: false,
        seen_override_effects: false,
        seen_override_iterations: false
    };
    if declared_count > 5
        || declared_count != declared_dimensions.len
        || declared_count != declared_lengths.len
        || declared_count != declared_values.len
        || override_count > 5
        || override_count != override_dimensions.len
        || override_count != override_lengths.len
        || override_count != override_values.len {
        return EnvelopeMergeState { ..initial, status: 2 };
    }
    iterate i over declared_dimensions carrying declared_state: EnvelopeMergeState = initial {
        next declared_state = merge_declared_envelope_dimension(
            declared_state,
            declared_dimensions[i],
            declared_lengths[i],
            declared_values[i]
        );
    }
    iterate i over override_dimensions carrying merged_state: EnvelopeMergeState = declared_state {
        next merged_state = merge_override_envelope_dimension(
            merged_state,
            override_dimensions[i],
            override_lengths[i],
            override_values[i]
        );
    }
    return merged_state;
}

fn resolve_request_policy(
    schema: [byte; up_to 64],
    schema_length: u64,
    has_host_grants: bool,
    effect_policy: u64,
    step_budget: u64,
    has_call_depth_budget: bool,
    call_depth_budget: u64,
    override_count: u64,
    override_dimensions: [[byte; up_to 64]; up_to 5],
    override_lengths: [u64; up_to 5],
    override_values: [u64; up_to 5]
) -> (result: PolicyState) {
    let defaults: PolicyState = PolicyState {
        status: 0,
        steps: step_budget,
        call_depth: select(has_call_depth_budget, call_depth_budget, 1024),
        memory_cells: 10000000,
        effects: 1024,
        iterations: 1000000,
        seen_steps: false,
        seen_call_depth: false,
        seen_memory_cells: false,
        seen_effects: false,
        seen_iterations: false
    };
    let schema_01: [byte; 3] = [48, 46, 49];
    if !text_scan.equals(schema, schema_length, schema_01, 3) {
        return PolicyState { ..defaults, status: 1 };
    }
    if has_host_grants || effect_policy != 0 {
        return PolicyState { ..defaults, status: 2 };
    }
    if override_count > 5
        || override_count != override_dimensions.len
        || override_count != override_lengths.len
        || override_count != override_values.len {
        return PolicyState { ..defaults, status: 3 };
    }
    iterate i over override_dimensions carrying state: PolicyState = defaults {
        next state = merge_dimension(
            state,
            override_dimensions[i],
            override_lengths[i],
            override_values[i]
        );
    }
    return state;
}

// Completed is the only normal terminal outcome. Unknown and future tags
// remain abnormal until a VM contract explicitly classifies them otherwise.
fn is_completed_outcome(kind: [byte; up_to 64], kind_length: u64) -> (result: bool) {
    let completed: [byte; 9] = [99, 111, 109, 112, 108, 101, 116, 101, 100];
    return text_scan.equals(kind, kind_length, completed, 9);
}

// Type arguments are passed as an unambiguous length-prefixed byte packet.
// Language owns spelling normalization; the VM policy compares the frozen
// request projection with compiler-emitted instantiation rows.
fn packet_equal(
    left: [byte; up_to 1024],
    left_length: u64,
    right: [byte; up_to 1024],
    right_length: u64
) -> (result: bool) {
    if left_length != right_length
        || left_length != left.len
        || right_length != right.len {
        return false;
    }
    iterate i over left carrying same: bool = true {
        next same = same && left[i] == right[i];
    }
    return same;
}

fn consider_generic_entry(
    state: CallResolutionState,
    requested: [byte; up_to 1024],
    requested_length: u64,
    candidate: [byte; up_to 1024],
    candidate_length: u64,
    candidate_index: u64
) -> (result: CallResolutionState) {
    if !state.valid || state.found {
        return state;
    }
    if candidate_length != candidate.len {
        return CallResolutionState { ..state, valid: false };
    }
    if packet_equal(requested, requested_length, candidate, candidate_length) {
        return CallResolutionState { ..state, found: true, index: candidate_index };
    }
    return state;
}

fn find_generic_entry(
    requested: [byte; up_to 1024],
    requested_length: u64,
    candidate_packets: [[byte; up_to 1024]; up_to 1024],
    candidate_lengths: [u64; up_to 1024],
    candidate_count: u64
) -> (result: CallResolutionState) {
    let initial: CallResolutionState = CallResolutionState {
        valid: true,
        found: false,
        index: 0
    };
    if candidate_count != candidate_packets.len
        || candidate_count != candidate_lengths.len
        || requested_length != requested.len {
        return CallResolutionState { ..initial, valid: false };
    }
    iterate i over candidate_packets carrying state: CallResolutionState = initial {
        next state = consider_generic_entry(
            state,
            requested,
            requested_length,
            candidate_packets[i],
            candidate_lengths[i],
            i
        );
    }
    return state;
}

// status: 0 concrete, 1 generic, 2 type arguments on function identity,
// 3 missing generic arguments, 4 unknown callable, 5 arguments on a concrete
// named callable, 6 no realized generic entry, 7 no matching specialization,
// 8 invalid bounded policy input.
fn resolve_call_policy(
    target_kind: u64,
    has_type_arguments: bool,
    concrete_present: bool,
    concrete_index: u64,
    requested: [byte; up_to 1024],
    requested_length: u64,
    candidate_packets: [[byte; up_to 1024]; up_to 1024],
    candidate_lengths: [u64; up_to 1024],
    candidate_count: u64
) -> (result: CallResolutionDecision) {
    let invalid: CallResolutionDecision = CallResolutionDecision {
        status: 8,
        index: 0
    };
    if candidate_count > 1024
        || candidate_count != candidate_packets.len
        || candidate_count != candidate_lengths.len
        || requested_length != requested.len {
        return invalid;
    }
    if target_kind == 0 {
        if has_type_arguments {
            return CallResolutionDecision { ..invalid, status: 2 };
        }
        if concrete_present {
            return CallResolutionDecision { status: 0, index: concrete_index };
        }
        return CallResolutionDecision { ..invalid, status: 4 };
    }
    if target_kind != 1 {
        return invalid;
    }
    if !has_type_arguments {
        if concrete_present {
            return CallResolutionDecision { status: 0, index: concrete_index };
        }
        if candidate_count > 0 {
            return CallResolutionDecision { ..invalid, status: 3 };
        }
        return CallResolutionDecision { ..invalid, status: 4 };
    }
    if concrete_present {
        return CallResolutionDecision { ..invalid, status: 5 };
    }
    let candidate_result: CallResolutionState = find_generic_entry(
        requested,
        requested_length,
        candidate_packets,
        candidate_lengths,
        candidate_count
    );
    if !candidate_result.valid {
        return invalid;
    }
    if candidate_result.found {
        return CallResolutionDecision { status: 1, index: candidate_result.index };
    }
    if candidate_count == 0 {
        return CallResolutionDecision { ..invalid, status: 6 };
    }
    return CallResolutionDecision { ..invalid, status: 7 };
}
